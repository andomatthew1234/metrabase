{
  "name": "metrabase",
  "version": "1.0.0",
  "description": "High-performance media capture suite for Windows.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win msi"
  },
  "author": "Matthew",
  "license": "ISC",
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.metrabase.app",
    "productName": "Metrabase",
    "copyright": "Copyright © 2026 Matthew",
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "icon.ico",
      "target": [
        {
          "target": "msi",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "msi": {
      "oneClick": false,
      "perMachine": true,
      "shortcutName": "Metrabase",
      "runAfterFinish": true
    },
    "files": [
      "**/*",
      "!history.csv",
      "!dist/*",
      "!node_modules/*"
    ]
  }
}