{
  "name": "metrabase",
  "version": "1.1.0",
  "description": "High-performance media capture suite for Windows.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis"
  },
  "author": "Matthew",
  "license": "ISC",
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.metrabase.app",
    "productName": "Metrabase",
    "copyright": "Copyright © 2026 Matthew",
    "win": {
      "icon": "icon.ico",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "installerHeader": "installerHeader.bmp",
      "installerSidebar": "installerSidebar.bmp",
      "installerHeaderIcon": "icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Metrabase",
      "runAfterFinish": true,
      "artifactName": "Metrabase-Setup-${version}.${ext}"
    },
    "files": [
      "**/*",
      "!history.csv",
      "!dist/*",
      "!node_modules/*"
    ]
  }
}